# Zahashowane assety Astro – cache na rok
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Logo, ikony, obrazek OG – tydzień (nazwy stałe, treść może się zmienić)
/*.svg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800

# Pliki dla botów i AI – krótki cache, żeby nowe artykuły były widoczne szybko.
# Jawny charset: Workers serwują .txt jako text/plain bez utf-8, a treść jest po polsku.
/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8
/robots.txt
  Content-Type: text/plain; charset=utf-8
/humans.txt
  Content-Type: text/plain; charset=utf-8
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/sitemap-0.xml
  Cache-Control: public, max-age=3600
/aktualnosci/rss.xml
  Cache-Control: public, max-age=3600

# Nagłówki bezpieczeństwa
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
