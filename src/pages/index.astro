---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SITE, SERVICES, FAQ, PROJECTS, CASE_STUDY } from '../data/site';
import { getArticles } from '../lib/articles';
import { faqPage } from '../lib/schema';

const articles = (await getArticles()).slice(0, 3);
// Mapa id -> slug dla starych linków #article-<id> z poprzedniej wersji strony.
const legacyMap = Object.fromEntries((await getArticles()).map((a) => [a.id, a.slug]));
---
<Base
  title="Ubezpieczenia grupowe dla firm | grupowe.pro – broker Aura Consulting"
  description={SITE.description}
  path="/"
  schema={[faqPage(FAQ)]}
>
  <!-- HERO -->
  <header class="pt-36 pb-16 md:pt-44 md:pb-24 bg-gradient-to-b from-slate-50 to-white overflow-hidden">
    <div class="container mx-auto px-4 flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
      <div class="lg:w-1/2">
        <p class="text-pink font-extrabold tracking-widest text-xs uppercase mb-4">Broker ubezpieczeniowy dla firm</p>
        <h1 class="text-4xl md:text-5xl lg:text-[3.5rem] font-black text-slate-800 mb-6 leading-tight tracking-tight">Ubezpieczenia grupowe, <span class="text-pink">które pracownicy naprawdę cenią.</span></h1>
        <p class="text-lg text-slate-500 mb-8 leading-relaxed max-w-xl">Jako niezależny broker projektujemy programy ubezpieczeń dla pracowników: na życie, opiekę medyczną oraz ochronę na wypadek najpoważniejszych chorób. Porównujemy oferty całego rynku i negocjujemy warunki w Twoim imieniu. Badanie rynku i wdrożenie są w 100% bezpłatne.</p>
        <div class="flex gap-4 flex-wrap">
          <a href="/kontakt/" class="bg-navy hover:bg-slate-800 text-white font-bold py-3.5 px-8 rounded-xl shadow-lg transition-transform hover:-translate-y-1">Poproś o analizę ofert</a>
          <a href="#uslugi" class="bg-white border-2 border-slate-200 text-slate-700 font-bold py-3 px-8 rounded-xl hover:border-slate-300 hover:bg-slate-50 transition-colors">Poznaj programy</a>
        </div>
        <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3 text-sm font-semibold text-slate-600">
          <li>✓ Zezwolenie KNF nr 1972/13</li>
          <li>✓ Firmy od 3 pracowników</li>
          <li>✓ Usługa bezpłatna dla firmy</li>
        </ul>
      </div>
      <div class="lg:w-1/2 relative w-full mt-6 lg:mt-0">
        <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=1000&q=80" alt="Zespół pracowników w biurze – program ubezpieczeń grupowych" width="1000" height="667" loading="eager" fetchpriority="high" class="w-full h-[360px] lg:h-[480px] object-cover rounded-[40px] shadow-2xl" />
        <div class="absolute -bottom-6 -left-2 lg:-left-10 bg-white/95 backdrop-blur-xl p-5 rounded-3xl shadow-xl border border-white flex items-center gap-4">
          <img src="/mark.svg" alt="" width="80" height="92" class="h-12 w-auto shrink-0" aria-hidden="true" />
          <div>
            <p class="font-extrabold text-navy text-base leading-none">Ochrona 24/7</p>
            <p class="text-xs text-slate-500 mt-1 font-medium">W pracy i na całym świecie</p>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- USŁUGI -->
  <Section id="uslugi" eyebrow="Zakres ochrony" title="Cztery filary ochrony pracowników" lead="Zbuduj przewagę na rynku pracy dzięki programom benefitowym opartym na faktycznych potrzebach zespołu." class="border-t border-slate-100">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {SERVICES.map((s) => (
        <article class="bg-white rounded-[32px] border border-slate-200 overflow-hidden shadow-sm hover:shadow-2xl transition-all duration-300 group flex flex-col">
          <a href={`/${s.slug}/`} class="block overflow-hidden h-56" tabindex="-1" aria-hidden="true">
            <img src={s.image.src} alt="" width="1200" height="800" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          </a>
          <div class="p-8 flex flex-col flex-grow">
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">{s.badge}</p>
            <h3 class="text-xl font-bold text-navy mb-3"><a href={`/${s.slug}/`} class="hover:text-pink transition-colors">{s.name}</a></h3>
            <p class="text-slate-500 mb-6">{s.summary}</p>
            <a href={`/${s.slug}/`} class="mt-auto font-bold text-pink text-sm inline-flex items-center gap-2 group-hover:translate-x-2 transition-transform">Dowiedz się więcej &rarr;</a>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- DLACZEGO BROKER -->
  <Section id="dlaczego-my" class="bg-slate-50 border-y border-slate-200">
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-pink font-extrabold tracking-widest text-xs uppercase mb-3">Dlaczego broker</p>
        <h2 class="text-3xl font-extrabold text-navy mb-6 tracking-tight">Broker to Twój sojusznik, nie sprzedawca.</h2>
        <p class="text-slate-600 mb-4">W odróżnieniu od agenta, broker ubezpieczeniowy reprezentuje wyłącznie interesy klienta, a nie towarzystwa ubezpieczeniowego. Działamy na podstawie zezwolenia KNF, ponosimy odpowiedzialność za rekomendację i posiadamy obowiązkowe ubezpieczenie OC.</p>
        <p class="text-slate-600 mb-6">Porównujemy oferty wszystkich liczących się ubezpieczycieli, negocjujemy zakres i cenę, a po wdrożeniu zostajemy z Tobą: obsługujemy roszczenia i pilnujemy odnowień.</p>
        <a href="/o-nas/" class="font-bold text-pink hover:underline">Więcej o tym, jak pracujemy &rarr;</a>
      </div>
      <ul class="grid gap-4">
        {[
          ['Pełne porównanie rynku', 'Jedno zapytanie – oferty wszystkich liczących się towarzystw w jednej tabeli.'],
          ['Negocjacje w Twoim imieniu', 'Stawki i zakres, których firma nie uzyska samodzielnie.'],
          ['Bezpłatne wdrożenie i obsługa', 'Wynagradza nas ubezpieczyciel. Dla firmy usługa jest bezpłatna.'],
          ['Wsparcie przy roszczeniach', 'Pomagamy pracownikom uzyskać świadczenia, a działowi HR – oszczędzić czas.'],
        ].map(([t, d]) => (
          <li class="bg-white border border-slate-200 rounded-2xl p-5 flex gap-4">
            <span class="text-mint font-black text-xl leading-none" aria-hidden="true">✓</span>
            <div><p class="font-bold text-navy">{t}</p><p class="text-sm text-slate-500 mt-1">{d}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- CASE STUDY -->
  <Section id="case-study" eyebrow="Case study" title="Ten sam budżet, maksymalny zakres" lead="Zobacz, jak realnie optymalizujemy koszty w firmach.">
    <div class="max-w-5xl mx-auto bg-white rounded-[32px] border border-slate-200 overflow-hidden shadow-lg flex flex-col md:flex-row">
      <div class="md:w-2/5 bg-slate-800 p-8 flex flex-col justify-center text-white">
        <p class="text-pink font-bold text-xs uppercase tracking-widest mb-2">Klient</p>
        <h3 class="text-2xl font-bold mb-1">{CASE_STUDY.client}</h3>
        <p class="text-sm text-slate-300 mb-6">{CASE_STUDY.scope}</p>
        <div class="bg-slate-700/50 p-4 rounded-xl border border-slate-600">
          <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wider mb-1">Wyzwanie</p>
          <p class="text-sm font-medium">{CASE_STUDY.challenge}</p>
        </div>
      </div>
      <div class="md:w-3/5 p-8 md:p-10 flex flex-col justify-center">
        <p class="text-sm font-bold text-pink uppercase tracking-widest mb-4">Analiza i wdrożenie</p>
        <p class="text-slate-600 leading-relaxed mb-4 text-sm">{CASE_STUDY.solution}</p>
        <div class="flex items-start gap-4 bg-emerald-50 p-5 rounded-xl border border-emerald-100">
          <span class="text-mint font-bold text-xl leading-none" aria-hidden="true">✓</span>
          <p class="text-sm text-slate-700 font-medium"><strong>Efekt:</strong> {CASE_STUDY.result}</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- AKTUALNOŚCI -->
  <Section id="aktualnosci" eyebrow="Wiedza ekspercka" title="Aktualności i trendy HR" lead="Raporty, zmiany w prawie pracy i porady dotyczące ubezpieczeń firmowych tworzone przez ekspertów Aura Consulting." class="bg-slate-50 border-y border-slate-200">
    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((a) => <ArticleCard article={a} />)}
      </div>
    ) : (
      <p class="text-center text-slate-400 py-10 border-2 border-dashed border-slate-200 rounded-3xl">Wkrótce opublikujemy pierwsze artykuły.</p>
    )}
    <p class="text-center mt-10"><a href="/aktualnosci/" class="inline-block bg-navy text-white font-bold py-3 px-8 rounded-xl hover:bg-slate-800 transition-colors">Wszystkie artykuły &rarr;</a></p>
  </Section>

  <!-- KONTAKT -->
  <Section id="kontakt">
    <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 bg-white rounded-[32px] overflow-hidden shadow-xl border border-slate-200">
      <div class="bg-navy p-10 flex flex-col justify-center text-white relative overflow-hidden">
        <img src="/mark-dark.svg" alt="" width="80" height="92" aria-hidden="true" class="absolute -right-10 -bottom-12 h-64 w-auto opacity-20 pointer-events-none" />
        <img src="/logo-dark.svg" alt="grupowe.pro" width="551" height="98" loading="lazy" class="h-8 w-auto self-start mb-8" />
        <h2 class="text-3xl font-extrabold mb-4">Działajmy razem.</h2>
        <p class="text-slate-300 mb-10 text-sm leading-relaxed">Wypełnij formularz. Przeanalizujemy strukturę zatrudnienia w Twojej firmie i w kilka dni przygotujemy porównanie ofert.</p>
        <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-1">Infolinia</p>
        <a href={SITE.phoneHref} class="text-3xl font-black hover:text-pink transition-colors mb-6">{SITE.phoneDisplay}</a>
        <p class="text-slate-400 text-[10px] font-bold uppercase tracking-widest mb-1">E-mail</p>
        <a href={`mailto:${SITE.email}`} class="text-lg font-bold hover:text-pink transition-colors">{SITE.email}</a>
      </div>
      <div class="p-8 lg:p-10 bg-slate-50"><ContactForm compact /></div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" eyebrow="FAQ" title="Częste pytania o ubezpieczenia grupowe" lead="Kluczowe informacje, które warto znać przed wdrożeniem programu.">
    <Faq items={FAQ} />
  </Section>

  <!-- PROJEKTY -->
  <Section id="projekty" title="Nasze projekty eksperckie" lead="Aura Consulting to grupa specjalistycznych platform ubezpieczeniowych." class="bg-slate-50 border-t border-slate-200">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {PROJECTS.map((p) => (
        <a href={p.href} target="_blank" rel="noopener" class="bg-white rounded-2xl text-center border border-slate-200 hover:-translate-y-2 hover:border-pink hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group">
          <div class="h-32 overflow-hidden"><img src={p.image} alt="" width="600" height="400" loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" /></div>
          <div class="p-5">
            <h3 class="text-base font-bold text-navy mb-2">{p.name}</h3>
            <p class="text-xs text-slate-500">{p.text}</p>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-12 text-center">
      <a href={SITE.instagram} target="_blank" rel="noopener" class="inline-flex items-center gap-3 bg-gradient-to-r from-[#833ab4] via-[#fd1d1d] to-[#fcb045] text-white px-8 py-4 rounded-xl font-bold hover:shadow-xl hover:-translate-y-1 transition-all shadow-md">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        Obserwuj @grupowe.pro na Instagramie
      </a>
    </p>
  </Section>

  <!-- Stare linki #article-<uuid> z poprzedniej wersji -> nowe adresy artykułów -->
  <script is:inline define:vars={{ legacyMap }}>
    const m = location.hash.match(/^#article-([0-9a-f-]{36})$/);
    if (m && legacyMap[m[1]]) location.replace('/aktualnosci/' + legacyMap[m[1]] + '/');
  </script>
</Base>
