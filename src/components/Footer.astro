---
import { SITE, COMPANY, SERVICES } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="bg-slate-50 border-t border-slate-200 mt-16">
  <div class="container mx-auto px-4 py-14 grid gap-10 md:grid-cols-4 text-sm">
    <div class="md:col-span-1">
      <a href="/" class="text-2xl font-black tracking-tighter text-navy">grupowe<span class="text-pink">.pro</span></a>
      <p class="text-slate-500 mt-3 leading-relaxed">Niezależny broker ubezpieczeniowy dla firm. Ubezpieczenia grupowe projektowane pod Twój zespół.</p>
      <p class="mt-4 font-bold"><a href={SITE.phoneHref} class="text-navy hover:text-pink">{SITE.phoneDisplay}</a></p>
      <p><a href={`mailto:${SITE.email}`} class="text-slate-600 hover:text-pink">{SITE.email}</a></p>
    </div>

    <nav aria-label="Usługi">
      <h2 class="font-black text-navy uppercase tracking-widest text-xs mb-3">Zakres ochrony</h2>
      <ul class="space-y-2">
        {SERVICES.map((s) => <li><a href={`/${s.slug}/`} class="text-slate-600 hover:text-pink">{s.name}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Strona">
      <h2 class="font-black text-navy uppercase tracking-widest text-xs mb-3">Strona</h2>
      <ul class="space-y-2">
        <li><a href="/o-nas/" class="text-slate-600 hover:text-pink">O nas – dlaczego broker</a></li>
        <li><a href="/aktualnosci/" class="text-slate-600 hover:text-pink">Aktualności i trendy HR</a></li>
        <li><a href="/kontakt/" class="text-slate-600 hover:text-pink">Kontakt i wycena</a></li>
        <li><a href={SITE.instagram} rel="noopener" target="_blank" class="text-slate-600 hover:text-pink">Instagram @grupowe.pro</a></li>
        <li><a href="/aktualnosci/rss.xml" class="text-slate-600 hover:text-pink">RSS</a></li>
      </ul>
    </nav>

    <nav aria-label="Dokumenty">
      <h2 class="font-black text-navy uppercase tracking-widest text-xs mb-3">Dokumenty</h2>
      <ul class="space-y-2">
        <li><a href="/polityka-prywatnosci/" class="text-slate-600 hover:text-pink">Polityka prywatności</a></li>
        <li><a href="/rodo/" class="text-slate-600 hover:text-pink">Nota informacyjna RODO</a></li>
        <li><a href="/regulamin/" class="text-slate-600 hover:text-pink">Regulamin serwisu</a></li>
        <li><a href="/llms.txt" class="text-slate-600 hover:text-pink">llms.txt (dla asystentów AI)</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-slate-200">
    <div class="container mx-auto px-4 py-6 text-[11px] text-slate-500 leading-relaxed">
      <p class="mb-2">© {year} {COMPANY.shortName}. Wszelkie prawa zastrzeżone.</p>
      <p>
        {COMPANY.legalName} z siedzibą w Warszawie, {COMPANY.street}, {COMPANY.postalCode} {COMPANY.city},
        wpisana do Krajowego Rejestru Sądowego pod numerem KRS {COMPANY.krs} przez {COMPANY.court},
        REGON {COMPANY.regon}, kapitał zakładowy {COMPANY.shareCapital}.
        Zezwolenie Komisji Nadzoru Finansowego nr {COMPANY.knfPermit}, wpis w rejestrze brokerów ubezpieczeniowych pod numerem {COMPANY.brokerRegister}.
      </p>
    </div>
  </div>
</footer>
