---
import { articleUrl, articleImage, formatDate, type Article } from '../lib/articles';
interface Props { article: Article; eager?: boolean }
const { article: a, eager = false } = Astro.props;
const img = articleImage(a, 800);
---
<article class="bg-white rounded-3xl shadow-sm hover:shadow-xl transition-all hover:-translate-y-1 border border-slate-200 flex flex-col overflow-hidden group">
  {img && (
    <a href={articleUrl(a)} class="block h-48 overflow-hidden" tabindex="-1" aria-hidden="true">
      <img src={img} alt="" width="800" height="450" loading={eager ? 'eager' : 'lazy'} decoding="async" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
    </a>
  )}
  <div class="p-7 flex flex-col flex-grow">
    {a.tags.length > 0 && (
      <ul class="flex gap-2 mb-4 flex-wrap" aria-label="Tagi">
        {a.tags.slice(0, 3).map((t) => <li class="bg-rose-50 text-pink text-[10px] px-2 py-1 rounded font-black uppercase tracking-wider">{t}</li>)}
      </ul>
    )}
    <h3 class="text-xl font-black text-navy mb-3 leading-snug group-hover:text-pink transition-colors">
      <a href={articleUrl(a)}>{a.title}</a>
    </h3>
    <p class="text-slate-500 text-sm mb-6 flex-grow line-clamp-4">{a.excerpt}</p>
    <div class="border-t border-slate-100 pt-4 flex justify-between items-center text-xs font-bold text-slate-400">
      <time datetime={a.published_at}>{formatDate(a.published_at)}</time>
      <span class="text-pink group-hover:translate-x-1 transition-transform">Czytaj całość →</span>
    </div>
  </div>
</article>
